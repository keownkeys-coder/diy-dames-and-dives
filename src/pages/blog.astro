---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import RSS_Dark from "../assets/pictures/svg/rss_dark.svg";
import RSSLogo from "../assets/pictures/svg/rss.svg";
import Social from '../components/Social.astro';
import { getCollection } from 'astro:content';
const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.flatMap((post: any) => (post.data.tags)))];
const authors = [...new Set(allPosts.flatMap((post: any) => (post.data.author)))];
//const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));    //non-collection based

const pageTitle = "Deranged type Blogalog";
//collection based
---
<BaseLayout pageTitle={pageTitle}>
  <p>my insane ramblings here for convenience</p>
  <ul> use dot leaders here--
    { 
     allPosts.map((post) => (
      <BlogPost url={`/posts/${post.id}/`} title={post.data.title} pubDate={post.data.pubDate.toLocaleDateString()}/>
     ))
    }
    </ul>
        <section id="blogTags">
        <ul class="tags">
        {tags.map((tag) => (

        
            <a class="tag" href={`/tags/${tag}`}>
                <li >{tag}</li>
            </a>
        ))}
        {authors.map((tag) => (

            <a class= "tag" href={`/tags/${tag}`}>
                <li>{tag}</li>
            </a>))}
        </ul>
        <p> If you'd like to keep up with my blog check it here! 
                     <Social platform="https://diy-dames-and-dives.netlify.app" usernameID="blog-feed.xml" logo={RSSLogo}darkLogo={RSS_Dark} platformName="RSS Feed" /> 
        </p>
    </section>
  
</BaseLayout>