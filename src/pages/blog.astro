---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { getCollection } from 'astro:content';
const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.flatMap((post: any) => (post.data.tags)))];
const authors = [...new Set(allPosts.flatMap((post: any) => (post.data.author)))];
//const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));    //non-collection based

const pageTitle = "Deranged type Blogalog";
//collection based
---
<BaseLayout pageTitle={pageTitle}>
  <p>my insane ramblings here for convenience</p>
  <ul> 
    { 
     allPosts.map((post) => (
      <BlogPost url={`/posts/${post.id}/`} title={post.data.title} pubDate={post.data.pubDate.toLocaleDateString()}/>
     ))
    }
    </ul>
        <section id="blogTags">
        <ul class="tags">
        {tags.map((tag) => (

        
            <a class="tag" href={`/tags/${tag}`}>
                <li >{tag}</li>
            </a>
        ))}
        {authors.map((tag) => (

            <a class= "tag" href={`/tags/${tag}`}>
                <li>{tag}</li>
            </a>))}
        </ul>
    </section>
  
</BaseLayout>