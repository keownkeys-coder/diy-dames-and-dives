---
import ThemeIcon from "./ThemeIcon.astro";
import Menu from "./Menu.astro";
import SearchIcon from "../assets/pictures/svg/search.svg";
import SearchDark from "../assets/pictures/svg/search_dark.svg";
---
<div class="header">
    <ThemeIcon />
    <Menu />
    <svg aria-hidden="true" width="5rem" height="5rem" xmlns="http://www.w3.org/2000/svg" >
        <SearchIcon class="logo" width={75} height={75} fill={"currentColor"}/>
        <SearchDark class="logoDark" width={75} height={75} fill={"currentColor"}/>
    </svg>
    
</div>